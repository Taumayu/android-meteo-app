<?xml version="1.0" encoding="utf-8"?>
<!-- Fond pour les petites cartes horaires (reste de la journée).
     Gradient subtil bleu-violet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/hourly_start"
        android:endColor="@color/hourly_end"
        android:angle="135" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_stroke" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Fond pour les petites cartes horaires (reste de la journée).
     Gradient subtil bleu-violet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#2A3A5E"
        android:endColor="#3A2A5E"
        android:angle="135" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#22FFFFFF" />
</shape>

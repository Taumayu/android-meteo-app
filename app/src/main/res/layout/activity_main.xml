<?xml version="1.0" encoding="utf-8"?>
<!-- Layout principal de l'app météo.
     Structure : deux colonnes dans un LinearLayout horizontal.
     - Gauche (weight=6) : météo actuelle + reste de la journée
     - Droite (weight=4) : prévisions 5 jours
     Le dernier rafraîchissement est affiché en haut à gauche. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="16dp">

    <!-- ═══════════════════════════════════════════
         CONTENU PRINCIPAL : 2 colonnes
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ─────────────────────────────────────
             COLONNE GAUCHE (60%) :
             Dernière MAJ + Météo actuelle + Reste de la journée
             ───────────────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <!-- Top Bar: Dernière MAJ + Boutons (Search, GPS) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvLastUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:textColor="#8888AA"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light"
                    tools:text="Last update : 23:43" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_search"
                        android:contentDescription="@string/search"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnGps"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_mylocation"
                        android:contentDescription="@string/gps_location"
                        android:layout_marginStart="8dp"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </RelativeLayout>

            <!-- ══════ CARTE MÉTÉO ACTUELLE ══════ -->
            <LinearLayout
                android:id="@+id/cardCurrentWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <!-- Ligne : Température + Icône -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvCurrentTemp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FFFFFF"
                        android:textSize="64sp"
                        android:fontFamily="sans-serif-thin"
                        tools:text="22°" />

                    <ImageView
                        android:id="@+id/ivCurrentIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="Icône météo actuelle"
                        tools:src="@android:drawable/ic_menu_day" />
                </LinearLayout>

                <!-- Nom de la ville -->
                <TextView
                    android:id="@+id/tvCityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Paris"
                    android:layout_marginBottom="4dp" />

                <!-- Description météo -->
                <TextView
                    android:id="@+id/tvWeatherDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAACC"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="italic"
                    tools:text="Ciel dégagé"
                    android:layout_marginBottom="16dp" />

                <!-- Séparateur -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33FFFFFF"
                    android:layout_marginBottom="12dp" />

                <!-- Détails : Ressenti -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/feels_like"
                        android:textColor="#8888AA"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvFeelsLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCCCEE"
                        android:textSize="13sp"
                        tools:text="22°C" />
                </LinearLayout>

                <!-- Détails : Humidité -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/humidity"
                        android:textColor="#8888AA"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCCCEE"
                        android:textSize="13sp"
                        tools:text="60%" />
                </LinearLayout>

                <!-- Détails : Vent -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wind"
                        android:textColor="#8888AA"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvWind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCCCEE"
                        android:textSize="13sp"
                        tools:text="2.7 m/s" />
                </LinearLayout>

                <!-- Détails : Pression -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pressure"
                        android:textColor="#8888AA"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPressure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCCCEE"
                        android:textSize="13sp"
                        tools:text="1013 hPa" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════ RESTE DE LA JOURNÉE ══════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rest_of_day"
                android:textColor="#CCCCEE"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHourlyForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <!-- ─────────────────────────────────────
             COLONNE DROITE (40%) :
             Prévisions 5 jours
             ───────────────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/five_day_forecast"
                android:textColor="#CCCCEE"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <!-- Liste des 5 jours -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDailyForecast"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
